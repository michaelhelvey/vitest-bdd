{
  "name": "@michaelhelvey/vitest-bdd",
  "version": "3.0.1",
  "description": "A BDD (Behavior-Driven Development) testing helper for Vitest that provides a structured given/when/it pattern with isolated world state for each test.",
  "license": "MIT",
  "author": {
    "name": "Michael Helvey",
    "email": "michael.helvey1@gmail.com",
    "url": "https://github.com/michaelhelvey"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelhelvey/vitest-bdd"
  },
  "files": [
    "dist",
    "ts-plugin",
    "src/globals.d.ts",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      }
    },
    "./ts-plugin": "./dist/ts-plugin.cjs",
    "./globals": {
      "types": "./src/globals.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vp config && bun link",
    "prepublish": "bun run validate",
    "test": "vp test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "vp lint --fix",
    "fmt": "vp fmt",
    "build": "vp pack",
    "attw": "attw --pack . --exclude-entrypoints ./ts-plugin --ignore-rules no-resolution cjs-resolves-to-esm",
    "validate": "bun run build && bun run lint && bun run test --run && bun run attw"
  },
  "dependencies": {
    "magic-string": "0.30.21"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.8.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "6.0.2",
    "vite-plus": "0.1.14"
  },
  "peerDependencies": {
    "vite-plus": ">=0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
